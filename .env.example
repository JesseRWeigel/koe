# Database (required)
DATABASE_URL="postgresql://user:password@host:5432/koe"

# AI Provider - Local (Ollama) — free, runs on your GPU
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_AI_PROVIDER="ollama"  # "ollama" for local, "gateway" for cloud

# AI Provider - Cloud (Vercel AI Gateway)
# Use an API key locally, or run `vercel link && vercel env pull` for SDK-managed OIDC.
AI_GATEWAY_API_KEY=""
# Optional. HTTPS only; credentials, query strings, fragments, and redirects are rejected.
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v3/ai"
GATEWAY_CHAT_MODEL="anthropic/claude-sonnet-4.6"
GATEWAY_GRAMMAR_MODEL="anthropic/claude-haiku-4.5"
GATEWAY_CONTENT_MODEL="anthropic/claude-sonnet-4.6"
# VERCEL_OIDC_TOKEN is managed automatically on Vercel deployments.

# Text-to-Speech (optional)
# Leave blank to use browser-native TTS as fallback
ELEVENLABS_API_KEY=""
